{
  "name": "puzzle-press",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "build": "esbuild src/ui/main.js --bundle --minify --format=esm --target=es2020 --outfile=public/app.js",
    "dev": "esbuild src/ui/main.js --bundle --format=esm --target=es2020 --outfile=public/app.js --servedir=public --serve=127.0.0.1:8787",
    "sample": "node scripts/sample.mjs",
    "test:browser": "node test/browser.mjs",
    "images": "node scripts/images.mjs",
    "demo": "node scripts/demo.mjs",
    "gallery": "node scripts/gallery.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "wrangler": "^4.131.0"
  }
}
