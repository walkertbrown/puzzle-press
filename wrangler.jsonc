{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puzzle-press",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/config.js", "/api/*"]
  },
  "observability": { "enabled": true },
  // /api/verify is an unauthenticated POST that spends Stripe read calls —
  // two today, up to twenty-one once the account holds a couple of thousand
  // payments. Before this there was no limit of any kind: five rapid curls
  // from one machine on 2026-09-14 were all served. A loop from one laptop
  // could burn the free plan's daily Worker budget and push the account into
  // Stripe's read rate limit, which would break unlock for real buyers on the
  // one day it matters. Ten tries a minute per IP is far more than a person
  // fixing a typo needs and far less than a script wants.
  "unsafe": {
    "bindings": [
      {
        "name": "VERIFY_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },
  // One key per /go/ arrival, 90-day expiry: the zone log forgets after 24h.
  // Read with scripts/golog.mjs.
  "kv_namespaces": [{ "binding": "GO_LOG", "id": "c06aaf6a74b24f918ed32cf5949ce513" }],
  // Studio domain. Bananafest Destiny is the studio; products live on subdomains.
  "routes": [{ "pattern": "puzzlepress.bananafest-destiny.com", "custom_domain": true }],
  "workers_dev": true,
  // Non-secret config. Secrets (STRIPE_KEY) are set with `wrangler secret put`.
  "vars": {
    // Public Stripe Payment Link — customers click it, so it is not a secret.
    // LIVE link — real charges.
    "PAY_URL": "https://buy.stripe.com/6oU8wR4Z026hf3lgFVeIw00"
  }
}
